@startuml MINTIFY System

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam class {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #333333
    FontSize 12
}
skinparam package {
    BackgroundColor #F8F8F8
    BorderColor #AAAAAA
}

' ============================================================
' EXTERNAL SERVICES
' ============================================================
class Qdrant <<database :6333>> #LightYellow {
    +query_points()
    +upsert()
    +scroll()
}

class vLLM <<component :8002/:8004>> #LightYellow {
    +GET v1/models
    +POST v1/chat/completions
}

class Browser <<client>> #LightGray {
}

' ============================================================
' PIPELINES CONTAINER — port 9099
' ============================================================
package "pipelines (port 9099)" #DDEEFF {

    class Pipeline {
        +id : str = "mintify_pipeline"
        +name : str = "MINTIFY"
        +type : str = "manifold"
        +valves : Valves
        --
        +pipelines() : list
        +pipe(user_message, model_id, messages, body) : Generator
        +on_startup()
        +on_shutdown()
        -_load_valves() : dict
    }

    class Valves <<Pydantic BaseModel>> {
        +BACKEND_URL : str
        +TOP_K : int = 5
        +SYSTEM_PROMPT : str
    }

    Pipeline *-down- Valves : contains
}

' ============================================================
' RAG BACKEND — port 8080
' ============================================================
package "rag-backend/app (port 8080)" #DDFFD8 {

    package "config" {
        class Settings <<Pydantic BaseSettings>> {
            +vllm_base_urls : str
            +qdrant_url : str
            +collection_name : str
            +embedding_model : str
            +upload_dir : str
            +chunk_size : int = 800
            +chunk_overlap : int = 100
            +top_k : int = 5
            --
            +vllm_urls : list <<property>>
        }
    }

    package "routers" {
        class PipeRequest <<Pydantic BaseModel>> {
            +user_message : str
            +model_id : str
            +messages : list
            +temperature : float = 0.7
            +system_prompt : str
            +top_k : int = 5
        }

        class RouteRag <<route POST /api/pipe>> {
            +pipe(req : PipeRequest) : StreamingResponse
        }

        class RouteModels <<route GET /api/models>> {
            +models() : dict
        }

        class RouteHealth <<route GET /api/health>> {
            +health() : dict
        }
    }

    package "services" {
        class Embedder {
            -_model : SentenceTransformer
            --
            +encode(text : str) : list
        }

        class Retriever {
            -_qdrant : QdrantClient
            -_collection : str
            --
            +retrieve(query_vec, top_k) : tuple
        }

        class Indexer {
            -_embedder : Embedder
            -_qdrant : QdrantClient
            -_settings : Settings
            -_indexed_hashes : set
            --
            +startup()
            +index_new_files()
            -_ensure_collection()
            -_prefetch_indexed_hashes()
            -_index_all_files()
            -_index_file(path : str)
            -_chunk_text(text : str) : list
            -_file_hash(path : str) : str
        }

        class LLMClient {
            -_vllm_urls : list
            -_model_url_map : dict
            --
            +refresh_model_map() : dict
            +stream(messages, model, temperature) : Generator
            -_resolve_url(model : str) : str
        }
    }

    note as DepNote
        <b>dependencies.py</b>
        Singletons created once at startup
        via init_singletons().
        Injected into routes via Depends().
    end note
}

' ============================================================
' INTERNAL RELATIONSHIPS
' ============================================================
Indexer *--> Embedder     : has
Indexer ..> Settings      : uses
Retriever ..> Settings    : uses

RouteRag ..> PipeRequest  : receives body
RouteRag ..> Embedder     : Depends()
RouteRag ..> Retriever    : Depends()
RouteRag ..> Indexer      : Depends()
RouteRag ..> LLMClient    : Depends()
RouteModels ..> LLMClient : Depends()

' ============================================================
' EXTERNAL CALLS
' ============================================================
Retriever -right-> Qdrant   : query_points()
Indexer -right-> Qdrant     : upsert() scroll()
LLMClient -right-> vLLM     : chat completions streaming
RouteModels ..> vLLM        : GET v1/models

' ============================================================
' CROSS-CONTAINER HTTP
' ============================================================
Browser -down-> Pipeline    : chat message
Pipeline -down-> RouteRag   : POST api/pipe httpx stream
Pipeline -down-> RouteModels : GET api/models httpx

@enduml
